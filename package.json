{
  "name": "pi-ship",
  "version": "0.1.0",
  "description": "Deploy Pi to a remote server for secure terminal, Telegram, or Slack access",
  "homepage": "https://github.com/haseebeqx/pi-ship#readme",
  "bugs": {
    "url": "https://github.com/haseebeqx/pi-ship/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseebeqx/pi-ship.git"
  },
  "keywords": [
    "pi",
    "cli",
    "telegram",
    "slack",
    "streaming",
    "deployment",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-ship": "dist/cli.js",
    "pi-ship-pi": "dist/pi.js",
    "pi-ship-runtime": "dist/runtime.js"
  },
  "files": [
    "dist",
    "scripts",
    "docs",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "runtime": "tsx src/runtime.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "packageManager": "npm@11.6.1"
}
